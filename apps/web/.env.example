# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google OAuth (configured in Supabase dashboard)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# AI APIs (optional - users can add their own)
# OPENAI_API_KEY=your-openai-key
# ANTHROPIC_API_KEY=your-anthropic-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Error monitoring (optional, fully off by default — see docs/OBSERVABILITY.md)
# Setting this is the ONLY thing required to enable it; unset (the default)
# means zero behavior change, zero network calls, no warnings.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
