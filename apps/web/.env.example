# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_URL / SUPABASE_SERVICE_KEY are accepted as fallback names for the
# two vars above (some hosts inject those instead). Set the ones above, not
# these, unless your platform only gives you these.
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=

# Direct Postgres connections for LangGraph's checkpointer (pnpm setup:checkpointer).
# SUPABASE_DB_URL        — pooler, port 6543. Use for normal runtime queries.
# SUPABASE_DB_URL_DIRECT — direct, port 5432. Required for DDL/migrations (pooler can't do it).
# Non-local hosts are TLS-verified against the Supabase Root 2021 CA pinned in
# lib/graph/supabase-root-ca.ts; a local `supabase start` host uses no TLS.
# SUPABASE_DB_URL=postgresql://postgres:[password]@[host]:6543/postgres
# SUPABASE_DB_URL_DIRECT=postgresql://postgres:[password]@[host]:5432/postgres

# Google OAuth. Configured in the Supabase dashboard for the sign-in flow
# itself — but ALSO read directly by this app (lib/gmail/token.ts) to refresh
# a stored Gmail "monitor mailbox" token outside a browser session (sync,
# eventually cron). Must be the SAME client Supabase's Google provider uses;
# Google refuses to refresh a token issued under a different client_id.
# Without these set, sync falls back to the session's own short-lived token.
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# AI APIs (optional - users can add their own)
# OPENAI_API_KEY=your-openai-key
# ANTHROPIC_API_KEY=your-anthropic-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Error monitoring (optional, fully off by default: see docs/OBSERVABILITY.md)
# Setting this is the ONLY thing required to enable it; unset (the default)
# means zero behavior change, zero network calls, no warnings.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production

# Prompt monitoring in Langfuse (optional, fully off by default: see
# lib/observability/langfuse.ts and docs/OBSERVABILITY.md). All three are
# required together; any one missing is the same as unset. trace_spans in
# Postgres stays the system of record regardless. Cloud regions are separate
# accounts: US https://us.cloud.langfuse.com, EU https://cloud.langfuse.com.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# Kill switch for prompt and reply text. On unless set to something other than
# 1/true/on/yes (so a typo turns it off). Names, tokens, cost, timing, the
# user id and the session id still go.
# LANGFUSE_CAPTURE_CONTENT=1
# Whose prompt and reply text may be sent: a comma separated list of Cello user
# ids (the operator's own). Empty or unset sends nobody's, so everyone else
# contributes metadata only. Demo workspaces never send text.
# LANGFUSE_CONTENT_USER_IDS=
# Share of traces sent, 0 to 1, chosen per trace (default 1). A value that is
# not a number means 0. Demo traces use the lower of the two rates, and the
# demo default is 0.25 so a burst of visitors cannot use up the free tier.
# LANGFUSE_SAMPLE_RATE=1
# LANGFUSE_DEMO_SAMPLE_RATE=0.25
# On Vercel the environment and release come from VERCEL_ENV and
# VERCEL_GIT_COMMIT_SHA; locally the environment is "development".

# Production requires (on Vercel, or with NODE_ENV=production): API_ENCRYPTION_KEY,
# AUDIT_HMAC_KEY, SUPABASE_DB_URL (pooler) and the three Supabase vars above.
# Both keys must be EXACTLY 64 hex characters. Anything else, or an unset
# value, makes the first encrypt/decrypt/hint call throw (builds still pass).
# Local dev without VERCEL works with neither set, using weak dev-only fallbacks.
# Never reuse a production key locally, and back both up: losing
# API_ENCRYPTION_KEY makes every stored BYOK key and token unreadable.

# Encrypts stored API keys, Gmail tokens and employer-board credentials
# (lib/crypto.ts). Generate with `openssl rand -hex 32`.
# API_ENCRYPTION_KEY=

# Keys the coarse client hints on the access-code audit trail
# (lib/access/audit.ts). Its own secret, not API_ENCRYPTION_KEY. Generate with
# `openssl rand -hex 32`. Changing it changes every future hint.
# AUDIT_HMAC_KEY=

# Allows stdio MCP servers and the local-cli / local-server providers, which
# run commands and reach services on THIS machine. Default off. Set to 1 only
# on a machine you alone use (local dev, personal Docker); it is ignored when
# VERCEL is set. Never enable on a host other people can sign in to.
# CELLO_SELF_HOSTED=1

# Authenticates the harness cron endpoint (app/api/harness/autopilot,
# app/api/harness/cron) when it's invoked by a scheduler instead of a user.
# CRON_SECRET=

# Ask Cello's long and scheduled work (docs/AGENTS.md). A request that runs out of
# time hands over to POST /api/agent/continue, and the minute sweeper in the
# database starts due tasks through the same endpoint. Both sign the request body
# with this secret (HMAC-SHA256, header X-Cello-Signature), so it must be at least
# 16 characters and the same value in the app and in the database's Vault.
# Generate with `openssl rand -hex 32`.
# AGENT_CONTINUE_SECRET=
# Where the continue endpoint lives, when it is not this app's own address
# (NEXT_PUBLIC_APP_URL, or VERCEL_URL on Vercel). Locally the database reaches
# the host as host.docker.internal.
# AGENT_CONTINUE_URL=http://localhost:3000/api/agent/continue
# Free OpenRouter models tried, in order, when a paid call is refused or the
# monthly budget is spent. Ids that do not end in :free are ignored.
# AGENT_FREE_MODELS=qwen/qwen3.8-27b:free,poolside/laguna-s-2.1:free

# Overrides the synthetic email domain used for demo-access-code accounts
# (see app/api/access/redeem/route.ts). Defaults to demo.cello.invalid.
# DEMO_EMAIL_DOMAIN=

# Self-hosted SearXNG instance for company/contact research (optional, see
# lib/search/keys.ts). Falls back to whatever a user configures in Settings.
# SEARXNG_BASE_URL=http://localhost:8080

# Owner-run scripts under apps/web/scripts/ read one of these for a direct
# Postgres connection (same value as SUPABASE_DB_URL_DIRECT above). Checked
# in this order: POSTGRES_URL_NON_POOLING, then POSTGRES_URL, then
# DATABASE_URL, then SUPABASE_DB_URL.
# DATABASE_URL=
# POSTGRES_URL=
# POSTGRES_URL_NON_POOLING=

# Runs the paid LLM-judge evals in lib/evals/judged.eval.test.ts (skipped by
# default: they spend real money). OPENROUTER_API_KEY here is test-only
# convenience for that suite, never a runtime code path (BYOK keys always
# come from each user's own encrypted row, never an env var).
# RUN_JUDGE_EVALS=
# OPENROUTER_API_KEY=

# Assisted apply (browser-use in GitHub Actions — see
# .github/workflows/browser-apply.yml and lib/ats-apply/dispatch.ts).
# BROWSER_RUNNER_SECRET must match the SAME repo secret browser-apply.yml
# uses — it is how app/api/apply/bundle and app/api/apply/state recognize
# the runner (never a per-draft authorization; see those routes' headers).
# GH_ACTIONS_TOKEN needs `actions:write` on this repo to dispatch the
# workflow (a fine-grained PAT, or a GitHub App installation token).
# BROWSER_RUNNER_SECRET=
# GH_ACTIONS_TOKEN=
# GH_REPO_OWNER=Devil-Hawk
# GH_REPO_NAME=cello
# GH_WORKFLOW_REF=main

# The one account that sees the daily health report on the dashboard (its user id).
# Unset means nobody sees it in the app.
# OWNER_USER_ID=
