{
  "name": "@cello/extension",
  "version": "0.1.0",
  "private": true,
  "description": "Fills job applications in your own browser.",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit",
    "lint": "node scripts/lint-store.mjs",
    "test": "wxt prepare && vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "clean": "rm -rf .output .wxt node_modules"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "vite": "^7.0.0",
    "vitest": "^1.2.0",
    "wxt": "0.21.4"
  }
}
