{
  "name": "cello",
  "version": "0.1.0",
  "private": true,
  "description": "Career Engine for Leads & Opportunities - AI-powered job hunting tool",
  "keywords": ["job-search", "career", "ai", "automation"],
  "license": "MIT",
  "author": "Ankit Punjabi <ankitpunjabi89@gmail.com>",
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=8.0.0"
  },
  "pnpm": {
    "overrides": {
      "picomatch@<2.3.2": "^2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
      "ws@>=8.0.0 <8.21.0": "^8.21.0",
      "postcss@<8.5.18": "^8.5.18",
      "fast-uri@>=3.0.0 <3.1.7": "^3.1.7",
      "brace-expansion@>=4.0.0 <5.0.11": "^5.0.11",
      "nanoid@<3.3.18": "^3.3.18",
      "browserslist@<4.28.7": "^4.28.7",
      "@xmldom/xmldom@<0.8.15": "^0.8.15",
      "undici@>=7.0.0 <7.29.1": "^7.29.1",
      "axios@>=1.13.0 <1.20.0": "^1.20.0"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @cello/web dev",
    "build": "pnpm --filter @cello/web build",
    "start": "pnpm --filter @cello/web start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @cello/web db:migrate",
    "db:generate": "pnpm --filter @cello/web db:generate",
    "clean": "pnpm -r clean && rm -rf node_modules"
  }
}
